# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
# In production, prefer injecting these via your platform's secret manager
# (Kubernetes Secrets, AWS Secrets Manager, Vault, etc.) rather than a file on disk.

# --- Database connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_research_agent
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Connection pool (optional, sensible defaults exist) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- JPA / Hibernate (optional) ---
# validate = verify schema only (production default). Use migrations to change schema.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
